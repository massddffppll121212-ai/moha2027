<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_dark"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle_blue"
            android:contentDescription="تحويل الصوت إلى نص"
            android:padding="8dp"
            android:src="@drawable/ic_transcribe" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_dialog_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تفريغ وملخص المكالمة"
                android:textColor="#F8FAFC"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_dialog_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تحليل المحتوى واستخراج المهام"
                android:textColor="#60A5FA"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_close_dialog"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="إغلاق"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- تنبيه متطلب Firebase -->
    <TextView
        android:id="@+id/tv_ai_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_search_field"
        android:padding="10dp"
        android:text="ملاحظة: هذه نتائج تجريبية. تفعيل الذكاء الاصطناعي (Gemini) يتطلب ربط Firebase."
        android:textColor="#93C5FD"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- مؤشر التحميل -->
    <LinearLayout
        android:id="@+id/loading_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="28dp">

        <ProgressBar
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminateTint="#38BDF8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="جاري تحليل الصوت واستخراج الملخص..."
            android:textColor="#94A3B8"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- المحتوى بعد التحويل -->
    <ScrollView
        android:id="@+id/result_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ملخص المكالمة (3 نقاط)"
                android:textColor="#38BDF8"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_summary_points"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_pill_unselected"
                android:lineSpacingExtra="4dp"
                android:padding="12dp"
                android:textColor="#E2E8F0"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="المهام المستخرجة"
                android:textColor="#38BDF8"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_action_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_pill_unselected"
                android:lineSpacingExtra="4dp"
                android:padding="12dp"
                android:textColor="#E2E8F0"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="النص الكامل للمكالمة"
                android:textColor="#38BDF8"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_transcript_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_pill_unselected"
                android:lineSpacingExtra="5dp"
                android:padding="12dp"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/dialog_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="end"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_retranscribe"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_pill_unselected"
            android:minHeight="48dp"
            android:paddingHorizontal="14dp"
            android:text="إعادة التحويل"
            android:textAllCaps="false"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_copy_transcript"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_pill_selected"
            android:minHeight="48dp"
            android:paddingHorizontal="18dp"
            android:text="نسخ الكل"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_done_dialog"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_pill_unselected"
            android:minHeight="48dp"
            android:paddingHorizontal="18dp"
            android:text="إغلاق"
            android:textAllCaps="false"
            android:textColor="#CBD5E1"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
