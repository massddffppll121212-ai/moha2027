<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_dark"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/cb_note_select"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:buttonTint="#38BDF8"
            android:contentDescription="تحديد التسجيل الصوتي"
            android:gravity="center"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/iv_voice_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_surface"
            android:contentDescription="تسجيل صوتي"
            android:padding="11dp"
            android:src="@drawable/ic_mic_blue" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- اسم التسجيل الذي كتبه المستخدم -->
            <TextView
                android:id="@+id/tv_note_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="تسجيل صوتي"
                android:textColor="#F8FAFC"
                android:textDirection="anyRtl"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- التاريخ والمدة فقط -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_note_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#38BDF8"
                    android:textDirection="ltr"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:text="•"
                    android:textColor="#475569"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_note_timestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الآن"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_note_cloud_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="✓ محفوظ في voice_notes"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_note_play"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_circle_blue"
            android:contentDescription="تشغيل التسجيل الصوتي"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_play_arrow" />

        <ImageButton
            android:id="@+id/btn_note_share"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_circle_surface"
            android:contentDescription="مشاركة التسجيل الصوتي"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_share" />

        <ImageButton
            android:id="@+id/btn_note_delete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_delete"
            android:contentDescription="حذف التسجيل الصوتي"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_delete_outline" />
    </LinearLayout>

    <!-- معاينة النص المفرّغ + زر التحويل المثبت دائماً في التسجيلات الصوتية -->
    <TextView
        android:id="@+id/tv_note_transcript_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pill_unselected"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:textColor="#CBD5E1"
        android:textDirection="anyRtl"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/note_expanded_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="visible">

        <Button
            android:id="@+id/btn_note_transcribe"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_pill_selected"
            android:drawableStart="@drawable/ic_transcribe"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:minHeight="48dp"
            android:paddingHorizontal="18dp"
            android:text="تحويل لنص"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
