<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111"
    android:layoutDirection="rtl">

    <!-- الواجهة الرئيسية مباشرة بدون تسجيل دخول -->
    <LinearLayout
        android:id="@+id/vault_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- الشريط العلوي مع زر الإعدادات فوق على اليمين وشعار DonkeyEar والبحث والتحديث وتسجيل الخروج -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_circle_surface"
                android:contentDescription="الإعدادات"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_settings" />

            <ImageView
                android:id="@+id/iv_logo"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_donkeyear_logo_rounded" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_app_logo_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_app_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="DonkeyEar Recorder"
                    android:textColor="#FFC107"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_sync"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_circle_surface"
                android:contentDescription="مزامنة وتفريغ"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_cloud_sync" />

            <ImageButton
                android:id="@+id/btn_search"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_circle_surface"
                android:contentDescription="بحث"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_search_blue" />

            <ImageButton
                android:id="@+id/btn_refresh"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_surface"
                android:contentDescription="تحديث القائمة"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:padding="13dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>

        <!-- التابين الرئيسيين المنفصلين تماماً: [ المكالمات | تسجيلات صوتية ] -->
        <LinearLayout
            android:id="@+id/section_tabs_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="horizontal"
            android:padding="5dp">

            <TextView
                android:id="@+id/tab_calls"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_selected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:text="المكالمات"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tab_voice_notes"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:text="تسجيلات صوتية"
                android:textColor="#94A3B8"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- شريط البحث الدائم بالاسم أو الرقم أو التاريخ -->
        <LinearLayout
            android:id="@+id/search_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_search_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:visibility="visible">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="أيقونة البحث"
                android:src="@drawable/ic_search_blue" />

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="ابحث باسم المتصل أو التاريخ (مثال: 26/11)..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B"
                android:textDirection="anyRtl"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btn_pick_date_filter"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="تصفية حسب التاريخ"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:padding="13dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_calendar" />

            <ImageButton
                android:id="@+id/btn_clear_search"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="مسح البحث"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:padding="13dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_close"
                android:visibility="gone" />
        </LinearLayout>

        <!-- بطاقة حالة القسم النشط / الصلاحيات / الرفع السحابي -->
        <LinearLayout
            android:id="@+id/status_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_status_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مسجل المكالمات التلقائي مفعّل"
                    android:textColor="#F8FAFC"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_status_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="مجلد CallVault/Calls • 48 kHz • 256 kbps"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_grant_permissions"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_pill_selected"
                android:minHeight="48dp"
                android:paddingHorizontal="16dp"
                android:text="منح الصلاحيات"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- شريط الأدوات السريعة: تحديد الكل + حذف التسجيلات القصيرة -->
        <LinearLayout
            android:id="@+id/tools_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_enter_select_all"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_unselected"
                android:minHeight="48dp"
                android:paddingHorizontal="12dp"
                android:text="تحديد الكل"
                android:textAllCaps="false"
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_delete_short"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.3"
                android:background="@drawable/bg_pill_unselected"
                android:minHeight="48dp"
                android:paddingHorizontal="12dp"
                android:text="حذف القصيرة (&lt; 10 ث)"
                android:textAllCaps="false"
                android:textColor="#FCA5A5"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- شريط إجراءات التحديد المتعدد: تحديد/إلغاء الكل + إرسال المحدد + حذف المحدد -->
        <LinearLayout
            android:id="@+id/selection_action_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_selection_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="المحدد: 0"
                    android:textColor="#38BDF8"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_select_all_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_pill_unselected"
                    android:minHeight="48dp"
                    android:paddingHorizontal="14dp"
                    android:text="تحديد الكل"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_exit_selection"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_circle_surface"
                    android:contentDescription="إلغاء التحديد"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:padding="13dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_share_selected"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_selected"
                    android:minHeight="48dp"
                    android:text="إرسال المحدد"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_delete_selected"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_unselected"
                    android:minHeight="48dp"
                    android:text="حذف المحدد"
                    android:textAllCaps="false"
                    android:textColor="#FCA5A5"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- شريط الفلتر الخاص بقسم المكالمات فقط: الكل / واردة / صادرة -->
        <LinearLayout
            android:id="@+id/filter_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/filter_all"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_selected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:text="الكل"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/filter_incoming"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:text="واردة"
                android:textColor="#94A3B8"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/filter_outgoing"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:text="صادرة"
                android:textColor="#94A3B8"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- قوائم منفصلة تماماً + زر + الأحمر لتسجيل صوتي جديد -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- قائمة المكالمات فقط -->
            <ListView
                android:id="@+id/list_recordings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="10dp"
                android:paddingHorizontal="16dp"
                android:paddingBottom="16dp"
                android:scrollbars="none" />

            <!-- قائمة التسجيلات الصوتية اليدوية فقط -->
            <ListView
                android:id="@+id/list_voice_notes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="10dp"
                android:paddingHorizontal="16dp"
                android:paddingBottom="88dp"
                android:scrollbars="none"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/empty_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_circle_surface"
                    android:contentDescription="لا توجد عناصر"
                    android:padding="16dp"
                    android:src="@drawable/ic_vault_shield" />

                <TextView
                    android:id="@+id/tv_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="لا توجد مكالمات مسجلة"
                    android:textColor="#F8FAFC"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_empty_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="سيتم حفظ جميع المكالمات الواردة والصادرة تلقائياً في CallVault/Calls."
                    android:textColor="#94A3B8"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- زر + أحمر يظهر فقط في تاب تسجيلات صوتية -->
            <ImageButton
                android:id="@+id/fab_new_voice_note"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="18dp"
                android:background="@drawable/bg_fab_red"
                android:contentDescription="تسجيل صوتي جديد"
                android:elevation="8dp"
                android:minWidth="60dp"
                android:minHeight="60dp"
                android:padding="15dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_add_white"
                android:visibility="gone" />
        </FrameLayout>

        <!-- شريط التشغيل السفلي مع الموجة الصوتية التفاعلية -->
        <LinearLayout
            android:id="@+id/player_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_player_toggle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_circle_blue"
                    android:contentDescription="تشغيل أو إيقاف مؤقت"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_pause" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_now_playing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="جاري التشغيل..."
                        android:textColor="#F8FAFC"
                        android:textDirection="anyRtl"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_player_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="00:00 / 00:00"
                        android:textColor="#38BDF8"
                        android:textDirection="ltr"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_player_stop"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_circle_surface"
                    android:contentDescription="إغلاق المشغل"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:padding="13dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <com.example.AudioWaveformProgressView
                android:id="@+id/playback_waveform"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:contentDescription="شريط الموجة الصوتية للتشغيل"
                android:layoutDirection="ltr"
                android:minHeight="48dp"
                android:paddingVertical="4dp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
