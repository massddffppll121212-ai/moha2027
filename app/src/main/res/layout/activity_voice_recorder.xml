<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/voice_recorder_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <!-- الشريط العلوي -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="14dp">

        <ImageButton
            android:id="@+id/btn_back_voice"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_surface"
            android:contentDescription="رجوع"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تسجيل صوتي جديد"
                android:textColor="#F8FAFC"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الميكروفون فقط • مجلد CallVault/VoiceNotes"
                android:textColor="#60A5FA"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- اسم التسجيل الصوتي -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="اسم التسجيل الصوتي"
                android:textColor="#38BDF8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_voice_note_title"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_search_field"
                android:hint="اكتب اسم التسجيل (مثال: ملاحظة اجتماع)..."
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLength="150"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B"
                android:textDirection="anyRtl"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- بطاقة المؤقت وحالة التسجيل -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="18dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_dark"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tv_voice_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_unselected"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="جاهز للتسجيل اليدوي من الميكروفون"
                android:textColor="#93C5FD"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_voice_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="00:00"
                android:textColor="#F8FAFC"
                android:textDirection="ltr"
                android:textSize="54sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="MP3 • 48 kHz • 256 kbps"
                android:textColor="#64748B"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btn_voice_record_toggle"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_fab_red"
                android:contentDescription="بدء أو إيقاف التسجيل الصوتي"
                android:minWidth="88dp"
                android:minHeight="88dp"
                android:padding="24dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_mic" />

            <TextView
                android:id="@+id/tv_voice_action_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="اضغط لبدء التسجيل"
                android:textColor="#CBD5E1"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_cancel_voice_recording"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_pill_unselected"
                android:minHeight="48dp"
                android:paddingHorizontal="20dp"
                android:text="إلغاء التسجيل"
                android:textAllCaps="false"
                android:textColor="#FCA5A5"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
