<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_dark"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_direction"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_surface"
            android:contentDescription="نوع المكالمة"
            android:padding="11dp"
            android:src="@drawable/ic_call_incoming" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_caller_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="مكالمة واردة"
                android:textColor="#F8FAFC"
                android:textDirection="anyRtl"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_phone_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="+966 50 000 0000"
                android:textColor="#94A3B8"
                android:textDirection="ltr"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#38BDF8"
                    android:textDirection="ltr"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:text="•"
                    android:textColor="#475569"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_direction_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="واردة"
                    android:textColor="#60A5FA"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:text="•"
                    android:textColor="#475569"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_timestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الآن"
                    android:textColor="#64748B"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_cloud_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="✓ محفوظ في Firestore"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_play"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_circle_blue"
            android:contentDescription="تشغيل التسجيل"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_play_arrow" />

        <ImageButton
            android:id="@+id/btn_share"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_circle_surface"
            android:contentDescription="مشاركة التسجيل"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_share" />

        <ImageButton
            android:id="@+id/btn_delete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_delete"
            android:contentDescription="حذف التسجيل"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_delete_outline" />
    </LinearLayout>

    <!-- زر التحويل لنص يظهر عند الضغط على التسجيل -->
    <LinearLayout
        android:id="@+id/expanded_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_transcribe"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_pill_selected"
            android:drawableStart="@drawable/ic_transcribe"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:minHeight="48dp"
            android:paddingHorizontal="18dp"
            android:text="تحويل لنص"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
